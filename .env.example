# Public site URL. Use the Vercel URL for now, then https://getyeslo.com.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Supabase project. The URL may be omitted; the app falls back to this project.
NEXT_PUBLIC_SUPABASE_URL=https://kcyfdaqllqjgeexcqzct.supabase.co

# Publishable anon key. Required for the iOS API to verify a user JWT.
# Never put the service role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Required for live quote links, decision records, and the waitlist.
SUPABASE_SERVICE_ROLE_KEY=

